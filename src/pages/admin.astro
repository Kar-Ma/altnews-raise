---
import Base from '../layouts/Base.astro';
import { getSnapshot, credentials } from '../lib/source.mjs';
import { readState } from '../lib/store.mjs';
import { toRupees, formatINR, formatCount } from '../lib/money.mjs';
import { isAuthed, usingDefaultPassword, adminLocked, isDeployed } from '../lib/auth.mjs';
import { PRESETS, activePreset } from '../lib/presets.mjs';
import { storeKind, storeIsEphemeral } from '../lib/store.mjs';

export const prerender = false;

const authed = isAuthed(Astro.cookies);
const note = Astro.url.searchParams.get('note');
const state = await readState();
const s = authed ? await getSnapshot() : null;
const hasCreds = Boolean(credentials());
const preset = activePreset(state);
const locked = adminLocked();
const ephemeral = storeIsEphemeral();

// The checklist is the whole welcome. Four things, and it says which are done.
const steps = authed ? [
  {
    id: 'yours',
    title: 'Make it yours',
    done: state.org.name !== 'Your organisation',
    summary: state.org.name !== 'Your organisation'
      ? `Set up for ${state.org.name}.`
      : 'Name, tagline and the link your Donate button points at.',
  },
  {
    id: 'goal',
    title: 'Set this month’s goal',
    done: state.campaign.goalPaise > 0,
    summary: `${formatINR(state.campaign.goalPaise)} for ${s.cycle.label}. You can move it mid-month.`,
  },
  {
    id: 'razorpay',
    title: 'Connect Razorpay',
    done: hasCreds && state.source.mode === 'live',
    summary: hasCreds
      ? (state.source.mode === 'live' ? 'Live: reading real payments.' : 'Keys found, still showing demo numbers.')
      : 'Optional to try it. Required before the numbers are real.',
  },
  {
    id: 'share',
    title: 'Share it',
    done: false,
    summary: 'The poster and the link both draw themselves from the numbers above.',
  },
] : [];
const stepsDone = steps.filter((step) => step.done).length;
---
<Base title="Admin — Raise Meter" description="Private control panel." noindex={true}>
  <main class="wrap">
    {!authed ? (
      <div class="gate">
        <h1>{state.org.name}'s control panel</h1>
        <p class="gate-lede">
          This screen is for whoever runs the appeal. It sets the goal and the wording;
          it cannot see or move money. If you came here to donate,
          {' '}<a href="/">the public page is this way</a>.
        </p>

        {locked ? (
          <div class="card panel narrow">
            <p class="warn">
              <strong>Locked.</strong> This deployment has no <code>ADMIN_PASSWORD</code> set, so the
              panel refuses to open rather than fall back to a password published in the source code.
            </p>
            <p class="hint">
              Set <code>ADMIN_PASSWORD</code> and <code>SESSION_SALT</code> in the environment and
              redeploy. The public page carries on working meanwhile.
            </p>
          </div>
        ) : (
          <form class="card panel narrow" method="post" action="/api/admin">
            <input type="hidden" name="action" value="login" />
            <label>
              <span>Password</span>
              <input type="password" name="password" autocomplete="current-password" required autofocus />
            </label>
            <button class="btn btn-primary" type="submit">Sign in</button>
            {note && <p class="warn">{note}</p>}
            {usingDefaultPassword() && (
              <p class="hint">
                Running locally with no <code>ADMIN_PASSWORD</code>, so the password is
                {' '}<code>letmein</code>. Deployments refuse to open until you set a real one.
              </p>
            )}
          </form>
        )}
        <p class="gate-note"><a href="/about">What is Raise Meter?</a></p>
      </div>
    ) : (
      <>
        <header class="bar">
          <div>
            <h1>{state.org.name} — {s.cycle.label}</h1>
            <p class="bar-sub">
              <a href="/about">What Raise Meter is</a> · private control panel
              {storeKind() === 'kv' ? ' · settings in KV' : ''}
            </p>
          </div>
          <div class="bar-right">
            <span class={s.mode === 'live' ? 'pill pill-live' : 'pill'}>
              {s.mode === 'live' ? 'Live data' : 'Demo data'}
            </span>
            <a class="btn btn-ghost" href="/" target="_blank" rel="noopener">View the page ↗</a>
          </div>
        </header>

        {note && <p class="note">{note}</p>}

        {ephemeral && (
          <p class="note note-bad">
            <strong>Changes here will not stick.</strong> This is a serverless deployment with no key-value
            store attached, so the filesystem resets between requests. Add Vercel KV or an Upstash Redis
            database and set <code>KV_REST_API_URL</code> and <code>KV_REST_API_TOKEN</code>.
          </p>
        )}

        <div class="cols">
          <div class="stack">
            <section class="card panel">
              <div class="section-head">
                <h2>Getting started</h2>
                <span class="progress-count">{stepsDone} of {steps.length} done</span>
              </div>
              <ol class="steps">
                {steps.map((step, i) => (
                  <li class={step.done ? 'step step-done' : 'step'}>
                    <span class="step-num">{step.done ? '✓' : i + 1}</span>
                    <div>
                      <strong>{step.title}</strong>
                      <p>{step.summary}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>

            <section class="card panel" id="razorpay">
              <div class="section-head">
                <h2>Connect Razorpay</h2>
                <span class={hasCreds ? 'pill pill-live' : 'pill'}>{hasCreds ? 'Keys found' : 'Not connected'}</span>
              </div>
              <p class="hint">
                Raise Meter only ever <em>reads</em> payments. It never takes money, never creates a payment,
                and never writes a donor's details anywhere. Your existing Razorpay page keeps doing the collecting.
              </p>

              <details class="guide" open={!hasCreds}>
                <summary>How to connect it</summary>
                <ol class="guide-steps">
                  <li>In the Razorpay Dashboard, go to <strong>Account &amp; Settings → API Keys</strong> and press <strong>Generate Key</strong>. Only an Owner or Admin can do this.</li>
                  <li>Razorpay shows the secret once. Copy both halves then.</li>
                  <li>Put them in this deployment's environment:
                    <pre>RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
ADMIN_PASSWORD=something-long
SESSION_SALT=something-random</pre>
                  </li>
                  <li>Restart, press <strong>Test connection</strong> below, then switch the source to Live.</li>
                </ol>
                <p class="caution">
                  <strong>Keep the key yours.</strong> Razorpay does not issue read-only keys — one that can
                  read payments can also issue refunds, and the payments API returns donor email, phone and,
                  if you collect them for 80G, PAN and address. Run this on your own deployment and put the
                  key in your own environment. Don't hand it to anyone, including whoever showed you this.
                </p>
              </details>

              <div class="row">
                <form method="post" action="/api/admin">
                  <input type="hidden" name="action" value="test-razorpay" />
                  <button class="btn btn-ghost" type="submit">Test connection</button>
                </form>
                <form method="post" action="/api/admin" class="row">
                  <input type="hidden" name="action" value="source" />
                  <select name="mode">
                    <option value="demo" selected={state.source.mode !== 'live'}>Demo — generated numbers</option>
                    <option value="live" selected={state.source.mode === 'live'} disabled={!hasCreds}>Live — real payments</option>
                  </select>
                  <button class="btn btn-ghost" type="submit">Switch</button>
                </form>
              </div>

              {state.source.lastTest && (
                <p class={state.source.lastTest.ok ? 'result result-ok' : 'result result-bad'}>
                  {state.source.lastTest.message}
                </p>
              )}
              {s.error && <p class="result result-bad">Live read failed: {s.error}. The public page is showing zero online rather than a guess.</p>}
            </section>

            {state.source.mode !== 'live' && (
              <section class="card panel">
                <div class="section-head">
                  <h2>Try it out</h2>
                  <span class="pill">Demo only</span>
                </div>
                <p class="hint">
                  Drag these and watch the page and the poster redraw. Nothing here touches real data —
                  it only shapes the pretend month.
                </p>

                <div class="slider">
                  <label for="day">Day of the month</label>
                  <input type="range" id="day" name="day" min="1" max={s.cycle.totalDays} step="1"
                    value={Math.ceil(state.demo.dayOverride ?? s.cycle.dayOfCycle)} />
                  <output id="day-out">day {Math.ceil(state.demo.dayOverride ?? s.cycle.dayOfCycle)} of {s.cycle.totalDays}</output>
                </div>

                <div class="slider">
                  <label for="strength">How the month is going</label>
                  <input type="range" id="strength" name="strength" min="0.2" max="1.2" step="0.02"
                    value={state.demo.strength ?? 0.82} />
                  <output id="strength-out">{Math.round((state.demo.strength ?? 0.82) * 100)}% of goal by month end</output>
                </div>
                <p class="hint">Push it past 100% to see what the page does when the goal lands.</p>
              </section>
            )}

            <section class="card panel">
              <h2>Campaign</h2>
              <p class="hint">Everything the page and the poster say. Changes show up on the next load.</p>
              <form method="post" action="/api/admin" class="fields">
                <input type="hidden" name="action" value="campaign" />
                <label class="span2">
                  <span>Headline — the last word is set in red</span>
                  <input type="text" name="headline" value={state.campaign.headline} maxlength="120" />
                </label>
                <label class="span2">
                  <span>Sub-lines — one sentence each; the last one is highlighted</span>
                  <input type="text" name="subhead" value={state.campaign.subhead} maxlength="300" />
                </label>
                <label>
                  <span>This month's goal (₹)</span>
                  <input class="num" type="number" name="goal" min="1" step="1" value={toRupees(state.campaign.goalPaise)} required />
                </label>
                <label>
                  <span>Suggested donation (₹)</span>
                  <input class="num" type="number" name="suggested" min="1" step="1" value={toRupees(state.campaign.suggestedPaise)} required />
                </label>
                <label>
                  <span>Organisation</span>
                  <input type="text" name="orgName" value={state.org.name} maxlength="60" />
                </label>
                <label>
                  <span>Tagline</span>
                  <input type="text" name="tagline" value={state.org.tagline} maxlength="120" />
                </label>
                <label class="span2">
                  <span>Donate link — where the button and the QR code point</span>
                  <input type="url" name="donateUrl" value={state.org.donateUrl} maxlength="300" />
                </label>
                <label class="span2">
                  <span>Footer note</span>
                  <input type="text" name="note" value={state.campaign.note} maxlength="300" />
                </label>
                <div class="span2"><button class="btn btn-primary" type="submit">Save campaign</button></div>
              </form>
              <p class="hint">
                The suggested amount is what "another {formatCount(s.readersNeeded)} readers at
                {' '}{formatINR(s.suggestedPaise)}" counts in. Pick the figure most of your donors actually give.
              </p>
            </section>

            <section class="card panel">
              <h2>Money that didn't come through Razorpay</h2>
              <p class="hint">
                Cheques, bank transfers, anything banked directly. Add them here or the public total
                will read lower than your own books — and a transparency page that contradicts you is
                worse than no page at all.
              </p>

              <form method="post" action="/api/admin" class="fields">
                <input type="hidden" name="action" value="offline-add" />
                <label class="span2">
                  <span>What it was</span>
                  <input type="text" name="label" placeholder="Cheques banked, week 2" maxlength="80" />
                </label>
                <label>
                  <span>Amount (₹)</span>
                  <input class="num" type="number" name="amount" min="1" step="1" required />
                </label>
                <label>
                  <span>Date</span>
                  <input type="date" name="date" />
                </label>
                <div class="span2"><button class="btn btn-ghost" type="submit">Add to the total</button></div>
              </form>

              {state.offline.length > 0 && (
                <table>
                  <thead><tr><th>Entry</th><th>Date</th><th class="right">Amount</th><th></th></tr></thead>
                  <tbody>
                    {state.offline.map((entry) => (
                      <tr>
                        <td>{entry.label}</td>
                        <td class="num muted">{entry.dateISO || '—'}</td>
                        <td class="num right">{formatINR(entry.amountPaise)}</td>
                        <td class="right">
                          <form method="post" action="/api/admin">
                            <input type="hidden" name="action" value="offline-remove" />
                            <input type="hidden" name="id" value={entry.id} />
                            <button class="link-btn" type="submit">Remove</button>
                          </form>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </section>

            <section class="card panel">
              <h2>Starting point</h2>
              <p class="hint">Replaces the copy and the goal. Contributions you have entered by hand stay.</p>
              <div class="presets">
                {Object.entries(PRESETS).map(([key, item]) => (
                  <form method="post" action="/api/admin" class="preset">
                    <input type="hidden" name="action" value="preset" />
                    <input type="hidden" name="preset" value={key} />
                    <button class={preset === key ? 'preset-btn preset-current' : 'preset-btn'} type="submit">
                      <strong>{item.label}{preset === key ? ' · in use' : ''}</strong>
                      <span>{item.hint}</span>
                    </button>
                  </form>
                ))}
              </div>
            </section>

            <div class="footer-actions">
              <a class="btn btn-ghost" href="/about">What this is for</a>
              <form method="post" action="/api/admin">
                <input type="hidden" name="action" value="logout" />
                <button class="btn btn-ghost" type="submit">Sign out</button>
              </form>
            </div>
          </div>

          <aside class="preview">
            <div class="card panel">
              <div class="section-head"><h2>Right now</h2></div>
              <dl class="readout">
                <div><dt>Raised</dt><dd class="num strong" data-p="raised">{formatINR(s.raisedPaise)}</dd></div>
                <div><dt>Goal</dt><dd class="num" data-p="goal">{formatINR(s.goalPaise)}</dd></div>
                <div><dt>Online</dt><dd class="num" data-p="online">{formatINR(s.raisedOnlinePaise)}</dd></div>
                <div><dt>By hand</dt><dd class="num" data-p="offline">{formatINR(s.offlinePaise)}</dd></div>
                <div><dt>Percent</dt><dd class="num" data-p="percent">{Math.round(s.percent)}%</dd></div>
                <div><dt>Supporters</dt><dd class="num" data-p="supporters">{formatCount(s.supporters)}</dd></div>
              </dl>
              <p class="cta" data-p="cta">{s.callToAction}</p>
            </div>

            <div class="card panel">
              <div class="section-head"><h2>The poster</h2></div>
              <img id="poster" src="/poster.png" alt="This month's poster" width="1080" height="1350" />
              <div class="preview-links">
                <a href="/poster" target="_blank" rel="noopener">Open ↗</a>
                <a href="/thanks" target="_blank" rel="noopener">Supporter card ↗</a>
                <a href="/api/state.json" target="_blank" rel="noopener">JSON ↗</a>
              </div>
            </div>
          </aside>
        </div>
      </>
    )}
  </main>

  <style>
    main { padding-bottom: 4rem; }

    .gate { max-width: 24rem; padding: 4rem 0; }
    .gate h1 { font-size: 2rem; margin: 0 0 .75rem; }
    .gate-lede { color: var(--muted); font-size: .95rem; margin: 0 0 1.5rem; max-width: 46ch; }
    .gate-note { margin-top: 1rem; font-size: .88rem; color: var(--muted); }
    .narrow { display: flex; flex-direction: column; gap: .9rem; }

    .bar { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; padding: 2rem 0 1.25rem; flex-wrap: wrap; }
    .bar h1 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); }
    .bar-sub { margin: .3rem 0 0; font-size: .84rem; color: var(--muted); }
    .bar-sub a { color: var(--muted); }
    .bar-sub a:hover { color: var(--ink); }
    .bar-right { display: flex; align-items: center; gap: .6rem; }
    .pill {
      font-size: .74rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
      padding: .3rem .6rem; border-radius: 999px; border: 1px solid var(--rule); color: var(--muted);
    }
    .pill-live { border-color: var(--good); color: var(--good); background: #F0F5F1; }

    .note-bad { background: var(--accent-soft) !important; border-color: #F0CFCF !important; color: #7A1216 !important; }
    .note { background: var(--marigold-soft); border: 1px solid #E7CF95; color: #7A5610; padding: .7rem 1rem; border-radius: 9px; font-size: .9rem; }

    .cols { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(17rem, .85fr); gap: 1rem; align-items: start; }
    .stack { display: flex; flex-direction: column; gap: 1rem; }
    .panel { padding: 1.4rem; }
    .section-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .5rem; }
    h2 { font-size: 1.15rem; }
    .progress-count { font-size: .8rem; color: var(--muted); font-variant-numeric: tabular-nums; }

    .steps { list-style: none; margin: .8rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .7rem; }
    .step { display: flex; gap: .8rem; align-items: flex-start; }
    .step-num {
      flex-shrink: 0; width: 1.55rem; height: 1.55rem; border-radius: 50%;
      display: grid; place-items: center; font-size: .8rem; font-weight: 600;
      border: 1px solid var(--rule); color: var(--muted);
    }
    .step-done .step-num { background: var(--good); border-color: var(--good); color: #fff; }
    .step strong { font-size: .95rem; }
    .step p { margin: .1rem 0 0; font-size: .86rem; color: var(--muted); }

    .guide { margin: 1rem 0; border: 1px solid var(--rule); border-radius: 10px; background: var(--paper); }
    .guide summary { cursor: pointer; padding: .7rem .9rem; font-size: .9rem; font-weight: 600; }
    .guide[open] summary { border-bottom: 1px solid var(--rule); }
    .guide-steps { margin: .9rem 0; padding-left: 2.1rem; font-size: .89rem; }
    .guide-steps li + li { margin-top: .55rem; }
    .guide pre {
      background: var(--card); border: 1px solid var(--rule); border-radius: 8px;
      padding: .7rem .8rem; font-size: .78rem; overflow-x: auto; margin: .5rem 0 0;
    }
    .caution { margin: 0 .9rem .9rem; padding: .8rem .9rem; border-radius: 8px; background: var(--accent-soft); color: #7A1216; font-size: .85rem; }

    .result { font-size: .87rem; margin: .9rem 0 0; padding: .6rem .8rem; border-radius: 8px; }
    .result-ok { background: #F0F5F1; color: #2F5238; }
    .result-bad { background: var(--accent-soft); color: #7A1216; }

    .slider { display: grid; gap: .3rem; margin-top: 1rem; }
    .slider label { font-size: .78rem; font-weight: 600; color: var(--muted); }
    .slider input[type='range'] { width: 100%; accent-color: var(--accent); }
    .slider output { font-size: .85rem; font-variant-numeric: tabular-nums; }

    label { display: flex; flex-direction: column; gap: .35rem; font-size: .78rem; font-weight: 600; color: var(--muted); }
    input, select {
      font: inherit; font-size: .95rem; font-weight: 400; padding: .6rem .7rem; border-radius: 8px;
      border: 1px solid var(--rule); background: var(--paper); color: var(--ink); width: 100%;
    }
    input:focus, select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    input.num { font-variant-numeric: tabular-nums; }

    .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; align-items: end; margin-top: 1rem; }
    .fields .span2 { grid-column: 1 / -1; }
    .row { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; margin-top: .8rem; }

    table { width: 100%; border-collapse: collapse; margin-top: 1.2rem; font-size: .9rem; }
    th { text-align: left; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding-bottom: .5rem; border-bottom: 1px solid var(--rule); }
    td { padding: .6rem 0; border-bottom: 1px solid var(--rule); }
    .right { text-align: right; }
    .muted { color: var(--muted); }
    .link-btn { background: none; border: 0; color: var(--accent); font: inherit; font-size: .85rem; cursor: pointer; padding: 0; }

    .presets { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: .6rem; margin-top: 1rem; }
    .preset-btn {
      width: 100%; text-align: left; cursor: pointer; font: inherit;
      display: flex; flex-direction: column; gap: .25rem;
      padding: .8rem .9rem; border-radius: 10px; border: 1px solid var(--rule); background: var(--paper);
    }
    .preset-btn:hover { border-color: var(--ink); }
    .preset-btn span { font-size: .82rem; color: var(--muted); }
    .preset-current { border-color: var(--marigold); background: var(--marigold-soft); }

    .hint { color: var(--muted); font-size: .85rem; margin: .6rem 0 0; max-width: 64ch; }
    .warn { color: #7A1216; font-size: .85rem; margin: 0; }
    .footer-actions { display: flex; gap: .5rem; padding-bottom: 1rem; }

    .preview { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 1.25rem; }
    .readout { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem 1rem; margin: .6rem 0 0; }
    .readout dt { font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
    .readout dd { margin: .1rem 0 0; font-size: 1rem; }
    .readout .strong { font-weight: 700; font-size: 1.15rem; }
    .cta { font-size: .88rem; color: var(--accent); margin: 1rem 0 0; }
    #poster { width: 100%; height: auto; display: block; border: 1px solid var(--rule); border-radius: 8px; margin-top: .6rem; }
    .preview-links { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: .7rem; font-size: .82rem; }
    .preview-links a { color: var(--muted); }
    .preview-links a:hover { color: var(--ink); }

    @media (max-width: 900px) {
      .cols { grid-template-columns: 1fr; }
      .preview { position: static; }
      .fields { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    // The sliders are the point of the demo: drag, and the numbers and the
    // poster on the right redraw without a page reload.
    const day = document.getElementById('day');
    const strength = document.getElementById('strength');
    const poster = document.getElementById('poster');

    const inr = (paise) => '₹' + new Intl.NumberFormat('en-IN').format(Math.round(paise / 100));

    async function refresh() {
      const res = await fetch('/api/state.json', { cache: 'no-store' });
      const d = await res.json();
      const set = (key, value) => {
        const el = document.querySelector(`[data-p="${key}"]`);
        if (el) el.textContent = value;
      };
      set('raised', d.raised.display);
      set('goal', d.goal.display);
      set('online', inr(d.online));
      set('offline', inr(d.offline));
      set('percent', Math.round(d.percent) + '%');
      set('supporters', d.supportersDisplay);
      set('cta', d.callToAction);
      // The poster is cached for a minute, so ask for a fresh one explicitly.
      poster.src = '/poster.png?t=' + Date.now();
    }

    let pending;
    function push() {
      clearTimeout(pending);
      pending = setTimeout(async () => {
        const body = new FormData();
        body.set('action', 'demo');
        body.set('day', day.value);
        body.set('strength', strength.value);
        await fetch('/api/admin', { method: 'POST', body });
        await refresh();
      }, 250);
    }

    if (day && strength) {
      const dayOut = document.getElementById('day-out');
      const strengthOut = document.getElementById('strength-out');
      const total = day.max;
      day.addEventListener('input', () => {
        dayOut.textContent = `day ${day.value} of ${total}`;
        push();
      });
      strength.addEventListener('input', () => {
        strengthOut.textContent = `${Math.round(strength.value * 100)}% of goal by month end`;
        push();
      });
    }
  </script>
</Base>
