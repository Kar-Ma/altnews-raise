---
import Base from '../layouts/Base.astro';
import { getSnapshot } from '../lib/source.mjs';
import { formatINR } from '../lib/money.mjs';

export const prerender = false;

const s = await getSnapshot();

const benefits = [
  {
    title: 'The number is never stale',
    body: `The page reads your payments directly, so it is right at 2am on the 14th without anyone
      being awake. The poster draws itself from the same figure — there is no second copy to update
      and no version that quietly goes out of date after you post it.`,
  },
  {
    title: 'One link instead of a new graphic',
    body: `Share the page once. It unfurls on X and WhatsApp with the current total already in the
      preview, so the same link posted three weeks apart shows two different, correct numbers.`,
  },
  {
    title: 'The ask does its own arithmetic',
    body: `"₹6 lakh short — another 1,200 readers at ₹500 closes it" is the line that moves people,
      and it is the one most likely to be wrong when a human recalculates it under deadline.`,
  },
  {
    title: 'Supporters get something worth posting',
    body: `People already screenshot their payment receipt to say they gave. A receipt is a bad share:
      it shows a transaction, leaks the amount, and carries none of your campaign. This gives them a
      card that says what they stand for and brings your shortfall along with it.`,
  },
  {
    title: 'It counts your other channels too',
    body: `Cheques and bank transfers get entered by hand and added to the public figure, so the number
      on the page matches the number in your books. A transparency page that contradicts you is worse
      than no page at all.`,
  },
  {
    title: 'It is yours',
    body: `Open source, MIT. Fork it, read every line that produces a figure, deploy it on your own
      domain with your own keys. Nobody else needs access to your payment account — including whoever
      pointed you at this.`,
  },
];
---
<Base title="About Open Raise" description="A live monthly fundraising meter for reader-funded organisations in India.">
  <header class="wrap masthead">
    <a class="back" href="/">← {s.org.name}</a>
    <a class="back" href="/admin">Admin →</a>
  </header>
  <hr class="rule" />

  <main class="wrap">
    <section class="hero">
      <h1>Open Raise: a fundraising meter that keeps itself honest.</h1>
      <p class="lede">
        If your organisation runs a monthly appeal and someone on your team remakes a progress
        graphic by hand every few days, this replaces that job. It reads what has actually come in,
        works out what is still needed, and draws the poster itself.
      </p>
    </section>

    <section class="benefits">
      {benefits.map((item) => (
        <article>
          <h2>{item.title}</h2>
          <p>{item.body}</p>
        </article>
      ))}
    </section>

    <section class="card panel plain">
      <h2>What it does not do</h2>
      <ul class="plainlist">
        <li>It never takes a payment. Your existing Razorpay page keeps collecting; the Donate button points at it.</li>
        <li>It never stores a donor record. It reads amounts and dates, and drops everything else.</li>
        <li>It does not need your data to leave your control. You deploy it; the key stays in your environment.</li>
      </ul>
    </section>

    <section class="steps-section">
      <h2>Getting it running</h2>
      <ol class="steps">
        <li>
          <strong>Try it empty.</strong>
          <p>It starts in demo mode with invented numbers, so you can see the page, the poster and the
            supporter card before connecting anything.</p>
        </li>
        <li>
          <strong>Put your own words in.</strong>
          <p>Headline, sub-lines, goal, suggested amount and the link your Donate button points at —
            all from the admin screen, no code.</p>
        </li>
        <li>
          <strong>Connect Razorpay.</strong>
          <p>Generate a key in your Razorpay dashboard, put it in your deployment's environment, press
            Test connection, and switch the source to live.</p>
        </li>
        <li>
          <strong>Share the link.</strong>
          <p>Every month it resets on the 1st, Asia/Kolkata. Set the new goal and carry on.</p>
        </li>
      </ol>
    </section>

    <section class="card panel who">
      <h2>Who it suits</h2>
      <p>
        Anyone in India running a recurring public appeal on Razorpay: newsrooms, legal aid and rights
        groups, community kitchens, animal shelters, school and hospital funds. Nothing in it is
        specific to journalism — the current example is set up for a newsroom because that is where it
        started, and one press in the admin swaps it for a blank template.
      </p>
      <p class="fineprint">
        Currently reading {formatINR(s.goalPaise)} as this month's goal for {s.org.name}
        {s.mode === 'demo' ? ' with demo numbers.' : '.'}
      </p>
      <div class="who-actions">
        <a class="btn btn-primary" href="/admin">Open the admin</a>
        <a class="btn btn-ghost" href="/">See the public page</a>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <hr class="rule" />
    <p>Open source under the MIT licence. Read the code that produces every figure.</p>
  </footer>

  <style>
    .masthead { display: flex; justify-content: space-between; padding: 1.25rem 0; font-size: .9rem; }
    .back { color: var(--muted); text-decoration: none; }
    .back:hover { color: var(--ink); }

    main { padding-bottom: 3rem; }
    .hero { padding: 3rem 0 2.5rem; max-width: 34rem; }
    .hero h1 { font-size: clamp(2.1rem, 5.5vw, 3.2rem); line-height: 1.1; margin: 0; }
    .lede { font-size: 1.05rem; color: var(--muted); margin-top: 1rem; max-width: 58ch; }

    .benefits { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1.75rem 2.5rem; padding-bottom: 3rem; }
    .benefits h2 { font-size: 1.1rem; }
    .benefits p { margin: .45rem 0 0; color: var(--muted); font-size: .93rem; }

    .panel { padding: 1.6rem; }
    .plain h2, .who h2 { font-size: 1.15rem; margin-bottom: .8rem; }
    .plain { max-width: 64ch; }
    .plainlist { margin: 0; padding-left: 1.1rem; color: var(--muted); font-size: .93rem; max-width: 60ch; }
    .plainlist li + li { margin-top: .45rem; }

    .steps-section { padding: 3rem 0; }
    .steps-section h2 { font-size: 1.3rem; margin-bottom: 1.25rem; }
    .steps { counter-reset: step; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem; }
    .steps li { counter-increment: step; border-top: 2px solid var(--accent); padding-top: .8rem; }
    .steps li::before { content: counter(step); display: block; font-family: var(--serif); font-weight: 800; font-size: 1.6rem; color: var(--accent); line-height: 1; margin-bottom: .35rem; }
    .steps strong { font-size: .98rem; }
    .steps p { margin: .3rem 0 0; color: var(--muted); font-size: .9rem; }

    .who p { color: var(--muted); font-size: .95rem; max-width: 60ch; }
    .fineprint { font-size: .85rem !important; margin-top: .8rem; }
    .who-actions { display: flex; gap: .6rem; margin-top: 1.25rem; flex-wrap: wrap; }

    footer { padding-bottom: 3rem; color: var(--muted); font-size: .85rem; }
    footer p { margin-top: 1.25rem; max-width: 60ch; }
  </style>
</Base>
