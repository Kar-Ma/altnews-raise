---
import Base from '../layouts/Base.astro';
import Meter from '../components/Meter.astro';
import { getRaise, updatedLabel, isStale, giveUrl } from '../lib/raise.mjs';
import { formatINR, formatShort, formatCount } from '../lib/money.mjs';
import { qrSvg } from '../lib/qr.mjs';

export const prerender = false;

const s = await getRaise();
const qr = await qrSvg(s.donateUrl);

// The last word goes red, on the page and on the poster alike.
const words = s.campaign.headline.trim().split(' ');
const headLead = words.slice(0, -1).join(' ');
const headLast = words.at(-1);
const creed = s.campaign.subhead.split('.').map((l) => l.trim()).filter(Boolean);

const chips = [1, 2, 5, 10].map((n) => s.suggestedPaise * n);
const primary = s.ways.find((w) => w.primary) ?? s.ways[0];
const others = s.ways.filter((w) => w !== primary);
const stale = isStale(s.updatedAt);
---
<Base
  title={`Support ${s.org.name} — ${s.cycle.label}`}
  description={s.callToAction}
  noindex={s.preview}
>
  {s.preview && (
    <div class="demo-banner">
      <strong>PREVIEW</strong> — a proposed page for {s.org.name}, with illustrative figures. Not yet official.
    </div>
  )}

  <header class="wrap masthead">
    <a class="mark" href={s.org.siteUrl}>
      <span class="mark-name">{s.org.name}</span>
      <span class="mark-tag">{s.org.tagline}</span>
    </a>
  </header>
  <hr class="rule" />

  <main class="wrap">
    <section class="hero">
      <div>
        <h1>{headLead} <em>{headLast}</em></h1>
        <ul class="creed">
          {creed.map((line, i) => (
            <li class={i === creed.length - 1 ? 'creed-last' : undefined}>{line}</li>
          ))}
        </ul>
      </div>
      <div class={s.met ? 'seal seal-met' : 'seal'} aria-hidden="true">
        <span class="seal-top">{s.met ? 'Goal' : 'Reader'}</span>
        <span class="seal-big">{s.met ? 'met' : 'funded'}</span>
        <span class="seal-bottom">{s.cycle.monthName.slice(0, 3)} {new Date(s.cycle.startMs).getUTCFullYear()}</span>
      </div>
    </section>

    <section class="card panel">
      <Meter s={s} />
      <p class="cta-line">{s.callToAction}</p>
      <p class={stale ? 'stamp stamp-stale' : 'stamp'}>
        <span class="dot-mark" aria-hidden="true"></span>
        Figure {updatedLabel(s.updatedAt)}, by {s.org.name}.
        {stale && ' It may be behind.'}
      </p>
    </section>

    <!-- The line above already says the shortfall and the reader count, so
         these three say what it does not: how long, how fast, how many. -->
    <section class="stats">
      <div class="stat card">
        <div class="stat-value num">{s.cycle.daysLeft}</div>
        <div class="stat-label">{s.cycle.daysLeft === 1 ? 'day left' : 'days left'} in {s.cycle.monthName}</div>
      </div>
      {!s.met && (
        <div class="stat card">
          <div class="stat-value num">{formatINR(s.perDayNeededPaise)}</div>
          <div class="stat-label">a day, to get there</div>
        </div>
      )}
      {s.supporters > 0 && (
        <div class="stat card">
          <div class="stat-value num">{formatCount(s.supporters)}</div>
          <div class="stat-label">readers have given</div>
        </div>
      )}
      {s.met && (
        <div class="stat card">
          <div class="stat-value num">{formatShort(s.raisedPaise - s.goalPaise)}</div>
          <div class="stat-label">past the goal</div>
        </div>
      )}
    </section>

    <section class="give" id="give">
      <h2>Ways to give</h2>

      <div class="card panel primary-way">
        <div class="way-head">
          <h3>{primary.title}</h3>
          <p>{primary.blurb}</p>
        </div>

        <ul class="chips">
          {chips.map((paise) => (
            <li>
              <a class={paise === s.suggestedPaise ? 'chip chip-common' : 'chip'}
                 href={giveUrl(primary, paise)} target="_blank" rel="noopener">
                {formatINR(paise)}
                {paise === s.suggestedPaise && <span class="chip-tag">most common</span>}
              </a>
            </li>
          ))}
        </ul>

        <div class="way-actions">
          <a class="btn btn-primary" href={primary.url} target="_blank" rel="noopener">{primary.cta}</a>
          <div class="qr">
            <button class="qr-frame" set:html={qr} data-qr-open
              aria-label={`Enlarge the QR code for donating to ${s.org.name}`}></button>
            <span class="eyebrow">{s.qrCaption}</span>
          </div>
        </div>
      </div>

      <div class="other-ways">
        {others.map((way) => (
          <div class="card panel way">
            <h3>{way.title}</h3>
            <p>{way.blurb}</p>
            {way.url && way.cta && (
              <a class="btn btn-ghost" href={way.url} target="_blank" rel="noopener">{way.cta}</a>
            )}
          </div>
        ))}
      </div>

      <ul class="legal">
        <li>{s.legal.eightyG}</li>
        <li>{s.legal.fcra}</li>
      </ul>
    </section>

    <section class="card share">
      <div>
        <h2>Already given? Say so.</h2>
        <p>A card worth posting, instead of a screenshot of a payment receipt — and it carries this month's shortfall with it.</p>
      </div>
      <div class="share-actions">
        <a class="btn btn-primary" href="/thanks">Make a card</a>
        <a class="btn btn-ghost" href="/poster">This month's poster</a>
      </div>
    </section>
  </main>

  <dialog id="qr-box" aria-label="Scan to donate">
    <div class="qr-big" set:html={qr}></div>
    <p class="qr-big-caption">{s.qrCaption}</p>
    <p class="qr-big-url">{s.donateUrl.replace(/^https?:\/\//, '')}</p>
    <button class="btn btn-ghost" data-qr-close>Close</button>
  </dialog>

  <footer class="wrap">
    <hr class="rule" />
    <p>{s.campaign.note}</p>
    <p class="fine">
      {s.org.name} is published by {s.org.legalName}, a Section 8 not-for-profit company
      (CIN {s.org.cin}). Questions about giving: <a href={`mailto:${s.org.contact}`}>{s.org.contact}</a>.
    </p>
  </footer>

  <style>
    .masthead { display: flex; align-items: center; padding: 1.25rem 0; }
    .mark { display: flex; align-items: baseline; gap: .75rem; flex-wrap: wrap; text-decoration: none; }
    .mark-name { font-family: var(--serif); font-weight: 800; font-size: 1.3rem; }
    .mark-tag { color: var(--muted); font-size: .9rem; border-left: 1px solid var(--rule); padding-left: .75rem; }

    .hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: center; padding: 3.5rem 0 2.5rem; }
    .hero h1 { font-size: clamp(2.4rem, 7vw, 4.1rem); line-height: 1.08; font-weight: 800; max-width: 11.5em; }
    .hero h1 em { font-style: normal; color: var(--accent); }
    .creed { list-style: none; display: flex; flex-wrap: wrap; gap: .4rem .9rem; margin: 1.5rem 0 0; padding: 0; }
    .creed li { color: var(--muted); font-size: .95rem; }
    .creed li:not(:last-child)::after { content: '·'; margin-left: .9rem; opacity: .45; }
    .creed .creed-last { color: var(--accent); font-weight: 600; }

    .seal {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      width: 9.5rem; height: 9.5rem; border-radius: 50%;
      border: 2px solid var(--accent); outline: 1px solid var(--accent); outline-offset: 4px;
      color: var(--accent); transform: rotate(-8deg); opacity: .9; flex-shrink: 0;
    }
    .seal-top, .seal-bottom { font-size: .55rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; white-space: nowrap; }
    .seal-big { font-family: var(--serif); font-size: 1.55rem; font-weight: 700; line-height: 1.15; margin: .12rem 0; }
    .seal-bottom { border-top: 1px solid currentColor; padding-top: .3rem; margin-top: .2rem; }
    .seal-met { border-color: var(--marigold); outline-color: var(--marigold); color: #9A6A0F; background: var(--marigold-soft); }

    .panel { padding: 1.75rem; }
    .cta-line { font-family: var(--serif); font-size: clamp(1.15rem, 3.4vw, 1.5rem); font-weight: 700; margin: 1.5rem 0 0; color: var(--accent); }

    /* A hand-kept figure has to carry its own timestamp, or it is just an
       assertion. Past a week the page says so itself. */
    .stamp { display: flex; align-items: center; gap: .5rem; color: var(--muted); font-size: .84rem; margin: 1rem 0 0; }
    .dot-mark { width: 7px; height: 7px; border-radius: 50%; background: var(--good); flex-shrink: 0; }
    .stamp-stale { color: #8A6413; }
    .stamp-stale .dot-mark { background: var(--marigold); }

    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: .85rem; margin-top: .85rem; }
    .stat { padding: 1.2rem 1.25rem; }
    .stat-value { font-family: var(--serif); font-size: 2rem; font-weight: 800; line-height: 1; }
    .stat-label { color: var(--muted); font-size: .88rem; margin-top: .3rem; }

    .give { margin-top: 3rem; }
    .give h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .way-head h3 { font-size: 1.2rem; }
    .way-head p { color: var(--muted); font-size: .93rem; margin: .35rem 0 0; max-width: 52ch; }

    .chips { list-style: none; display: flex; flex-wrap: wrap; gap: .45rem; margin: 1.25rem 0 0; padding: 0; }
    .chip {
      display: inline-flex; align-items: baseline; gap: .4rem; text-decoration: none;
      padding: .45rem .8rem; border-radius: 999px; border: 1px solid var(--rule);
      font-size: .95rem; font-variant-numeric: tabular-nums; transition: border-color .12s ease;
    }
    .chip:hover { border-color: var(--ink); }
    .chip-common { border-color: var(--marigold); background: var(--marigold-soft); }
    .chip-tag { font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: #8A6413; }

    .way-actions { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 1.5rem; flex-wrap: wrap; }
    .qr { display: flex; flex-direction: column; align-items: center; gap: .5rem; }
    .qr-frame {
      width: 152px; height: 152px; padding: 9px; background: #fff;
      border: 1px solid var(--rule); border-radius: 8px; cursor: zoom-in;
      transition: border-color .12s ease, transform .12s ease;
    }
    .qr-frame:hover { border-color: var(--ink); transform: scale(1.03); }
    .qr-frame:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .qr-frame :global(svg) { width: 100%; height: 100%; display: block; }

    .other-ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: .85rem; margin-top: .85rem; }
    .way h3 { font-size: 1.05rem; }
    .way p { color: var(--muted); font-size: .9rem; margin: .35rem 0 1rem; }

    .legal { list-style: none; margin: 1.5rem 0 0; padding: 0; color: var(--muted); font-size: .84rem; max-width: 62ch; }
    .legal li + li { margin-top: .35rem; }

    .share { display: flex; gap: 1.5rem; align-items: center; justify-content: space-between; padding: 1.6rem 1.75rem; margin-top: 3rem; flex-wrap: wrap; }
    .share h2 { font-size: 1.3rem; }
    .share p { color: var(--muted); margin: .4rem 0 0; max-width: 46ch; font-size: .92rem; }
    .share-actions { display: flex; gap: .6rem; flex-wrap: wrap; }

    #qr-box {
      border: 1px solid var(--rule); border-radius: 16px; padding: 1.75rem;
      background: var(--card); color: var(--ink); text-align: center; max-width: min(92vw, 24rem);
    }
    #qr-box::backdrop { background: rgba(22, 19, 14, .72); }
    .qr-big { width: min(72vw, 17rem); height: min(72vw, 17rem); margin: 0 auto; background: #fff; padding: 10px; border-radius: 10px; }
    .qr-big :global(svg) { width: 100%; height: 100%; display: block; }
    .qr-big-caption { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 1rem 0 .2rem; }
    .qr-big-url { font-size: .9rem; margin: 0 0 1.25rem; word-break: break-all; }

    footer { padding-bottom: 3rem; color: var(--muted); font-size: .88rem; }
    footer p { margin-top: 1.25rem; max-width: 60ch; }
    .fine { font-size: .82rem; }

    @media (max-width: 760px) {
      .hero { grid-template-columns: 1fr; gap: 1.5rem; }
      .seal { justify-self: end; margin-right: 1rem; width: 7.5rem; height: 7.5rem; }
      .seal-big { font-size: 1.3rem; }
    }
    @media (max-width: 620px) {
      .panel { padding: 1.25rem; }
      .creed { gap: .15rem 1.1rem; }
      .creed li:not(:last-child)::after { content: none; }
      .way-actions { flex-direction: column-reverse; align-items: stretch; }
      .qr { align-self: flex-start; align-items: flex-start; }
      .btn-primary { width: 100%; }
    }
  </style>

  <script>
    const qrBox = document.getElementById('qr-box');
    document.querySelector('[data-qr-open]')?.addEventListener('click', () => qrBox.showModal());
    document.querySelector('[data-qr-close]')?.addEventListener('click', () => qrBox.close());
    qrBox?.addEventListener('click', (event) => {
      if (event.target === qrBox) qrBox.close();
    });
  </script>
</Base>
