---
import Base from '../layouts/Base.astro';
import { getRaise } from '../lib/raise.mjs';
import { cleanName } from '../lib/supporter.mjs';
import { formatShort } from '../lib/money.mjs';
import { publicUrl } from '../lib/url.mjs';

export const prerender = false;

const s = await getRaise();
const name = cleanName(Astro.url.searchParams.get('name'));

// Razorpay's post-payment redirect carries razorpay_payment_id and a signature,
// never the amount. Reading the amount would mean holding an API key, which is
// the one thing this app refuses to do — and asking people to type it would put
// an unverifiable number on a fact-checker's card. So the card says who, not
// how much.
const cardUrl = `/supporter.png?name=${encodeURIComponent(name)}`;
const homeUrl = publicUrl(Astro.request, Astro.url, '/');
---
<Base
  title={`Thank you — ${s.org.name}`}
  description={`${s.callToAction} Share that you chipped in.`}
  image={cardUrl}
  noindex={s.preview}>
  {s.preview && (
    <div class="demo-banner">
      <strong>PREVIEW</strong> — a proposed page for {s.org.name}, with illustrative figures. Not yet official.
    </div>
  )}

  <main class="wrap">
    <header class="head">
      <div class="eyebrow">Thank you</div>
      <h1>That's one more reader funding the work.</h1>
      <p>
        {s.met
          ? `${s.cycle.monthName} is funded.`
          : `${s.cycle.monthName} is at ${Math.round(s.percent)}% — ${formatShort(s.shortfallPaise)} to go.`}
        {' '}A share does more than the donation on its own. Here's something better to post than a payment screenshot.
      </p>
    </header>

    <div class="stage">
      <div class="preview">
        <img id="card" src={cardUrl} alt="Your supporter card" width="1080" height="1080" />
      </div>

      <form class="card panel" id="form">
        <label>
          <span>Name on the card</span>
          <input type="text" name="name" maxlength="32" value={name} placeholder="Leave blank to stay anonymous" autocomplete="name" />
        </label>

        <p class="hint">Leave it blank and the card says "a reader in {s.cycle.monthName}".</p>

        <ol class="steps">
          <li>
            <a class="btn btn-primary" id="download" href={cardUrl} download="i-fund-independent-journalism.png">Download the card</a>
          </li>
          <li>
            <a class="btn btn-ghost" id="tweet" href="#" target="_blank" rel="noopener">Open X, then attach it</a>
            <span>X will not let a link add your picture for you, so attach the file you just saved.</span>
          </li>
        </ol>

        <hr class="rule" />
        <p class="hint">
          Or just send the link — <a href="/">{homeUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a> —
          and it will show this month's progress on its own.
        </p>
      </form>
    </div>
  </main>

  <style>
    main { padding-bottom: 4rem; }
    .head { max-width: 48ch; padding: 2.5rem 0 2rem; }
    .head h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.08; margin-top: .5rem; }
    .head p { color: var(--muted); margin-top: 1rem; }

    .stage { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(17rem, .85fr); gap: 1.75rem; align-items: start; }
    .preview img { width: 100%; height: auto; display: block; border-radius: 12px; box-shadow: var(--shadow); }

    .panel { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
    label { display: flex; flex-direction: column; gap: .4rem; font-size: .85rem; font-weight: 600; }
    input[type='text'] {
      font: inherit; font-weight: 400; padding: .7rem .8rem; border-radius: 9px;
      border: 1px solid var(--rule); background: var(--paper); color: var(--ink);
    }
    input[type='text']:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    .hint { color: var(--muted); font-size: .82rem; margin: -.5rem 0 0; }
    .steps { list-style: none; counter-reset: step; margin: .5rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .9rem; }
    .steps li { counter-increment: step; display: flex; flex-direction: column; gap: .4rem; }
    .steps li::before {
      content: 'Step ' counter(step);
      font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted);
    }
    .steps .btn { width: 100%; }
    .steps span { color: var(--muted); font-size: .8rem; }

    @media (max-width: 780px) { .stage { grid-template-columns: 1fr; } }
  </style>

  <script define:vars={{ orgName: s.org.name, cta: s.callToAction, homeUrl }}>
    const form = document.getElementById('form');
    const card = document.getElementById('card');
    const download = document.getElementById('download');
    const tweet = document.getElementById('tweet');

    function refresh() {
      const name = (new FormData(form).get('name') || '').slice(0, 32);
      const url = '/supporter.png?name=' + encodeURIComponent(name);
      card.src = url;
      download.href = url;
      const text = `I fund independent journalism. ${orgName} is reader-funded — ${cta}`;
      tweet.href = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(text) +
        '&url=' + encodeURIComponent(homeUrl);
    }

    let timer;
    form.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(refresh, 350);
    });
    refresh();
  </script>

</Base>
